{
	"name": "lodger-web",
	"private": true,
	"version": "0.1.4",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test -c tests/playwright.config.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@codecov/sveltekit-plugin": "2.0.1",
		"@eslint/js": "10.0.1",
		"@fontsource-variable/inter": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@novnc/novnc": "1.7.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tabler/icons-svelte": "3.50.0",
		"@tailwindcss/vite": "4.3.4",
		"@tanstack/svelte-query": "6.3.11",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"bits-ui": "2.20.6",
		"cn": "0.5.2",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.14.0",
		"jsdom": "31.0.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"rollup-plugin-license": "3.7.1",
		"shadcn-svelte": "1.8.0",
		"spdx-expression-validate": "2.0.0",
		"spdx-satisfies": "6.0.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-variants": "4.0.1",
		"tailwindcss": "4.3.4",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	}
}
